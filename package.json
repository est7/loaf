{
  "name": "loaf-cli",
  "version": "0.1.0",
  "description": "Protocol kernel for the loaf feature-lifecycle workflow — single typed journal + in-memory projections.",
  "type": "module",
  "bin": {
    "loaf": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run build",
    "ga:pack-smoke": "bash scripts/ga-package-smoke.sh",
    "ga:consistency": "bash scripts/ga-consistency-check.sh",
    "ga:check": "bun run build && bun run ga:pack-smoke && bun run ga:consistency",
    "prepare": "test -d dist || npm run build",
    "prepublishOnly": "bun run check"
  },
  "packageManager": "bun@1.3.13",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "ink": "^7.0.2",
    "react": "^19.2.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
